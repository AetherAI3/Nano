{
  "type": "Strategy",
  "nanoIrVersion": "0.1.0",
  "name": "EndpointPostureDrift",
  "effects": ["intent.emit", "log.append"],
  "nodes": [
    { "type": "Schedule", "interval": "1h" },
    { "type": "Condition", "signal": "ENDPOINT_NONCOMPLIANT_PCT", "operator": ">=", "value": 5 },
    { "type": "Intent", "action": "OBSERVE" },
    { "type": "Agent", "name": "SecurityDesk" }
  ]
}

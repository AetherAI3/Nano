{
  "type": "Strategy",
  "nanoIrVersion": "0.1.0",
  "name": "UnsignedArtifactHold",
  "effects": ["intent.emit", "log.append"],
  "nodes": [
    { "type": "Schedule", "interval": "1m" },
    { "type": "Condition", "signal": "UNSIGNED_ARTIFACT_COUNT", "operator": ">=", "value": 1 },
    { "type": "Intent", "action": "PAUSE" },
    { "type": "Agent", "name": "SecurityDesk" }
  ]
}

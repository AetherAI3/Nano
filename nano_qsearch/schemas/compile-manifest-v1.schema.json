{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethersystems.net/schemas/nano-qsearch/compile-manifest-v1.schema.json",
  "title": "Nano packed compile manifest v1",
  "$comment": "Semantic validation additionally enforces ordered PUB positions, unique requested jobs and deliveries, increasing recipient slots, width/layout length agreement and frozen-request equality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_digest",
    "target",
    "profile",
    "compiler",
    "pubs"
  ],
  "properties": {
    "schema": {
      "const": "nano.qsearch.compile-manifest.v1"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "snapshot_digest",
        "calibration_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "calibration_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "digest"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "qiskit_version",
        "qiskit_ibm_runtime_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "qiskit_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "qiskit_ibm_runtime_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pubs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pub_index",
          "job_digest",
          "recipients",
          "n",
          "shots",
          "seed",
          "atlas_child_digest",
          "compiled_plan_digest",
          "isa_digest",
          "layout"
        ],
        "properties": {
          "pub_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "job_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agent_id",
                "chunk",
                "slot"
              ],
              "properties": {
                "agent_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "chunk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "slot": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "shots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "atlas_child_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "compiled_plan_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "isa_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "layout": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  }
}

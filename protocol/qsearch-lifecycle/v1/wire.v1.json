{
  "auth": {
    "algorithm": "HMAC-SHA256",
    "empty_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "header": "X-Aether-Qsearch-Auth",
    "mac_bytes": 32,
    "message": "METHOD\nPATH\nBODY_SHA256_HEX\nTS\nNONCE",
    "min_key_bytes": 16,
    "nonce_pattern": "^[0-9a-f]{16,64}$",
    "scheme": "v1",
    "window_s": 120
  },
  "client_error_codes": [
    "CLIENT_CONFIGURATION",
    "IDENTITY",
    "INVALID_RESPONSE",
    "REMOTE_ERROR",
    "TRANSPORT_UNAVAILABLE",
    "UNEXPECTED_REDIRECT",
    "UNSUPPORTED_CAPABILITY"
  ],
  "contract": "nano.qsearch.lifecycle-wire.v1",
  "default_timeout_s": 30,
  "job_state_schema": "nano.qsearch.job-state.v1",
  "max_json_depth": 64,
  "max_response_bytes": 1048576,
  "max_safe_integer": 9007199254740991,
  "next_actions": [
    "MANUAL_RECONCILIATION",
    "NONE",
    "POLL_STATUS",
    "RECONCILE",
    "REQUEST_CANCEL"
  ],
  "operations": {
    "status": {
      "body": "",
      "method": "GET",
      "path_template": "/qsearch/v2/requests/{request_digest}"
    }
  },
  "provider_statuses": [
    "CANCELED",
    "CANCELLED",
    "COMPLETED",
    "DONE",
    "ERROR",
    "FAILED",
    "INITIALIZING",
    "PENDING",
    "QUEUED",
    "RUNNING",
    "UNKNOWN",
    "VALIDATING"
  ],
  "remote_codes": [
    "ACCOUNTING_EXPIRED",
    "ACCOUNTING_PENDING",
    "BODY_TOO_LARGE",
    "CANCELLATION_FENCE_REQUIRED",
    "CANCELLATION_NOT_AUTHORIZED",
    "CANCELLATION_PENDING",
    "CANCELLATION_REQUESTED",
    "CANCEL_ACKNOWLEDGEMENT_UNKNOWN",
    "EMPTY_BODY_REQUIRED",
    "IDENTITY",
    "INVALID_ACTION",
    "INVALID_CONTENT_LENGTH",
    "INVALID_JSON",
    "INVALID_REQUEST",
    "JSON",
    "LIFECYCLE_ADAPTER_UNAVAILABLE",
    "LIFECYCLE_BUSY",
    "LIFECYCLE_TARGET_UNSUPPORTED",
    "LIFECYCLE_UNAVAILABLE",
    "LIVE_CONTEXT_REQUIRED",
    "NEW_IDENTITY_REQUIRED",
    "NEW_TARGET_REQUIRED",
    "NOT_ENABLED",
    "NOT_FOUND",
    "ORIGINAL_ATTEMPT_UNRECONCILED",
    "PROVIDER_IDENTITY_MISMATCH",
    "PROVIDER_OR_STORE_UNAVAILABLE",
    "PROVIDER_STATUS_UNKNOWN",
    "PROVIDER_SUBMISSION_AMBIGUOUS",
    "PROVIDER_SUBMISSION_UNKNOWN",
    "PROVIDER_UNAVAILABLE",
    "QUEUE_EXPIRED",
    "REPLACEMENT_BLOCKED",
    "REPLACEMENT_CONFLICT",
    "REPLACEMENT_IDENTITY",
    "REPLACEMENT_TARGET",
    "REQUEST_BUSY",
    "REQUEST_CONFLICT",
    "REQUEST_ID_CONFLICT",
    "REQUEST_NOT_FOUND",
    "STATE_UNAVAILABLE",
    "STORE_UNAVAILABLE",
    "UNAUTHORIZED"
  ],
  "remote_fields": [
    "authority",
    "body",
    "descriptor",
    "descriptor.max_execution_time",
    "descriptor.request_id",
    "descriptor.target",
    "headers.Content-Length",
    "jobs",
    "replacement",
    "request_digest",
    "request_id",
    "target"
  ],
  "request_digest_pattern": "^sha256:[0-9a-f]{64}$",
  "request_headers": {
    "Accept": "application/json"
  },
  "unsupported_operations": [
    "cancel",
    "refresh",
    "replace"
  ]
}
